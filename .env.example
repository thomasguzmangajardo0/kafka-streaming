# Copie este archivo a ".env" (no se sube a git) y complete los valores de su cuenta AWS.

# --- IDaaS: Amazon Cognito (user pool) ---
# Issuer: https://cognito-idp.<región>.amazonaws.com/<userPoolId>
IDAAS_ISSUER_URI=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX
# App client id del frontend (el backend valida que el token fue emitido para esta aplicación)
IDAAS_AUDIENCE=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Orígenes permitidos por CORS (URL del frontend, separadas por coma)
CORS_ALLOWED_ORIGINS=https://dxxxxxxxxxxxx.cloudfront.net,http://localhost:4200

# --- Base de datos cloud: Amazon RDS (PostgreSQL o MySQL) ---
DB_URL=jdbc:postgresql://<endpoint-rds>:5432/pedidosdb
DB_USERNAME=postgres
DB_PASSWORD=cambie-esta-clave

# --- RabbitMQ ---
RABBIT_USER=admin
RABBIT_PASSWORD=cambie-esta-clave
RABBITMQ_ERLANG_COOKIE=cambie-esta-cookie
